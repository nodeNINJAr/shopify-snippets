      "placeholder": "https://example.com/audio.mp3"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Audio Title (optional)",
      "default": "My Audio Track"
    }
  ]
}